# BEGIN unity-code-style-guide: Unity ignore rules
# Install at the Unity project root (the folder that contains Assets/). Rules are anchored with a
# leading slash to that folder. See SetupVersionControl.md; edit outside this block, not inside it.

# --- Unity-generated folders and files (GitHub's Unity template) ---
.utmp/
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
*.log

# By default Unity supports Blender imports; *.blend1 backups do not belong in version control.
*.blend1
*.blend1.meta

# MemoryCaptures can get excessive in size and can contain sensitive data.
/[Mm]emoryCaptures/

# Recordings can get excessive in size.
/[Rr]ecordings/

# Uncomment this line to ignore the Asset Store tools plugin.
# /[Aa]ssets/AssetStoreTools*

# Autogenerated Rider plugin and personal-layer settings.
/[Aa]ssets/Plugins/Editor/JetBrains*
*.DotSettings.user

# IDE caches and generated solution and project files.
.vs/
.gradle/
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity-generated meta files for the generated files above.
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Crash reports.
sysinfo.txt
mono_crash.*

# Builds and installers.
*.apk
*.aab
*.ipa
*.unitypackage
*.unitypackage.meta
*.app

# Build-side folders: Burst debug symbols and IL2CPP backups sit beside a player and are never shipped.
*_BurstDebugInformation_DoNotShip/
*_BackUpThisFolder_ButDontShipItWithYourGame/

# Crashlytics.
crashlytics-build.properties

# Test Runner generated scenes.
InitTestScene*.unity*
/[Aa]ssets/[Ii]nit[Tt]est[Ss]cene*.unity*

# Addressables generated content.
/ServerData
/[Aa]ssets/StreamingAssets/aa*
/[Aa]ssets/AddressableAssetsData/link.xml*
/[Aa]ssets/Addressables_Temp*
/[Aa]ssets/AddressableAssetsData/*/*.bin*

# Visual Scripting generated files.
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db.meta
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers.meta

# UI Toolkit generated schema and the scene dependency cache.
/UIElementsSchema/
/[Aa]ssets/[Ss]ceneDependencyCache*

# --- Profiling and diagnostic captures: large, machine-specific, regenerable ---
# Profiler "Save" writes .data files into ProfilerCaptures/ by default. Keep a capture you need as a
# shared baseline outside the repository, or in LFS by an explicit decision.
[Pp]rofilerCaptures/
[Pp]rofilerCaptures.meta
*.pdata
*.snap
*.rdc
*.diagsession
*.etl

# --- Starter conventions (see the VersionControl readme) ---
# BEGIN ThirdPartyAssets (optional): vendor imports in Assets/ThirdPartyAssets are re-imported from their
# source instead of committed. Remove this whole section when a clean clone, or CI, has no access to
# those sources. Unity's `vcs doctor` reports META_FILES_IGNORED while that folder's .meta exists locally;
# that finding is expected, and a clean clone (CI) does not trigger it.
/[Aa]ssets/ThirdPartyAssets/
/[Aa]ssets/ThirdPartyAssets.meta
# END ThirdPartyAssets

# Editors and operating systems.
.idea/
/.vscode/*
!/.vscode/extensions.json
.DS_Store
Thumbs.db
# END unity-code-style-guide: Unity ignore rules
