# Optional starter: merge into a target project's .gitattributes.
* text=auto
*.cs text eol=lf
*.uxml text eol=lf
*.uss text eol=lf
*.meta text eol=lf

# Enable only after configuring/testing the local UnityYAMLMerge driver.
# *.unity text eol=lf merge=unityyamlmerge
# *.prefab text eol=lf merge=unityyamlmerge
# *.asset text eol=lf merge=unityyamlmerge

# Keep binary payloads byte-identical without requiring LFS.
*.png binary
*.jpg binary
*.jpeg binary
*.psd binary
*.fbx binary
*.wav binary
*.mp3 binary
*.ogg binary

# Optional LFS: install it on all workstations/CI before enabling selected categories.
# *.psd filter=lfs diff=lfs merge=lfs -text
# *.fbx filter=lfs diff=lfs merge=lfs -text
# *.wav filter=lfs diff=lfs merge=lfs -text
